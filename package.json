{
  "name": "@inkdropapp/mcp-server",
  "version": "1.9.0",
  "description": "Inkdrop Model Context Protocol Server",
  "keywords": [
    "Claude",
    "Inkdrop",
    "MCP"
  ],
  "license": "Apache-2.0",
  "author": "Takuya Matsuyama<contact@inkdrop.app>",
  "repository": {
    "type": "git",
    "url": "https://github.com/inkdropapp/mcp-server.git"
  },
  "bin": {
    "inkdrop-mcp-server": "dist/index.js"
  },
  "type": "module",
  "scripts": {
    "start": "bun src/index.ts",
    "build": "tsc && chmod +x dist/*.js",
    "prepublishOnly": "npm run build",
    "watch": "tsc --watch",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@inkdropapp/protocol-utils": "^1.0.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ajv": "^8.20.0",
    "inkdrop-model": "^3.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nkzw/oxlint-config": "^3.0.0",
    "@types/node": "^26.6.6",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.94.0",
    "tsrs": "7.1.0-beta.tsrs3",
    "typescript": "^7.0.2"
  }
}
